{
  "name": "ai-job-finder",
  "version": "1.0.0",
  "description": "Local-first job discovery: fetches postings, deduplicates them, filters them against your profile, and ranks them with a local LLM.",
  "license": "MIT",
  "author": "Mirza Aleem Abbas",
  "private": false,
  "type": "module",
  "keywords": [
    "job-search",
    "ollama",
    "local-llm",
    "sqlite",
    "cli",
    "self-hosted"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "tsx watch src/cli/index.ts run",
    "build": "tsc -p tsconfig.build.json && cp -R src/dashboard/public dist/dashboard/public",
    "start": "node dist/cli/index.js run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "jobs:fetch": "tsx src/cli/index.ts fetch",
    "jobs:match": "tsx src/cli/index.ts match",
    "jobs:export": "tsx src/cli/index.ts export",
    "jobs:run": "tsx src/cli/index.ts run",
    "jobs:models": "tsx src/cli/index.ts models",
    "jobs:schedule": "tsx src/cli/index.ts schedule",
    "jobs:dashboard": "tsx src/cli/index.ts dashboard"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "dotenv": "^17.4.2",
    "node-cron": "^4.6.0",
    "playwright": "^1.63.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}

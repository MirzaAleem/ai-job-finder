# Copy to .env and edit:  cp .env.example .env
# .env is gitignored. Never commit real keys.

NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------- DATABASE --
# A SQLite file. Created on first run, along with its parent directory.
# There is nothing to install and no server to start.
SQLITE_PATH=data/job-finder.db

# --------------------------------------------------------- LOCAL LLM (default)
# Ollama is the primary provider. Every job is evaluated here first.
OLLAMA_BASE_URL=http://localhost:11434
# Any installed Ollama model. See what you have: `pnpm jobs:models`
#   ollama pull qwen3:8b
#   ollama pull llama3.1:8b
#   ollama pull gemma3:4b
OLLAMA_MODEL=llama3.1:8b
# Batched 8B inference genuinely takes minutes. Raise this, not lower it.
OLLAMA_TIMEOUT_MS=300000
# Raise if you increase LLM_BATCH_SIZE or LLM_MAX_DESCRIPTION_CHARS.
OLLAMA_NUM_CTX=8192

# ------------------------------------------------ CLOUD LLM (escalation only)
# The cloud model is an expert fallback, not the default. With a healthy local
# model and a threshold of 0.80, most runs make zero cloud calls.
# openrouter | gemini | none
CLOUD_PROVIDER=openrouter
CLOUD_ESCALATION_ENABLED=true
# Escalate when local confidence falls below this.
LLM_CONFIDENCE_THRESHOLD=0.80
# Small models flag "the posting didn't state a salary" constantly. Such soft
# flags only escalate once this many are set at once (or alongside low
# confidence). Set to 1 to escalate on any single flag — expect far more cloud
# calls if you do.
LLM_SOFT_FLAG_THRESHOLD=2
# Hard ceiling per run, so a bad batch cannot drain your account.
CLOUD_MAX_REQUESTS_PER_RUN=25

# OpenRouter keys look like sk-or-v1-...
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-nano
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google AI Studio keys (used when CLOUD_PROVIDER=gemini). NOT interchangeable
# with an OpenRouter key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# USD per 1M tokens, for the run cost estimate only. Set these to your model's
# real prices — the defaults are a cheap-flash-tier guess, not a quote.
CLOUD_INPUT_COST_PER_MTOK=0.10
CLOUD_OUTPUT_COST_PER_MTOK=0.40

# ---------------------------------------------------------- LLM ECONOMY -----
# Jobs per local request. Higher is cheaper but needs more context.
LLM_BATCH_SIZE=5
# Descriptions are truncated to this before being sent to any model.
LLM_MAX_DESCRIPTION_CHARS=4000
# Retries on malformed local output before escalating.
LLM_MAX_RETRIES=1
# Skip re-evaluating jobs whose content has not changed.
LLM_CACHE_ENABLED=true

# ---------------------------------------------------- SCORING THRESHOLDS ----
SCORE_HIGH_PRIORITY=90
SCORE_APPLY=80
SCORE_CONSIDER=65

# ------------------------------------------------------------- SOURCES ------
# Comma-separated: mock | import | companies
# Start with `mock` — it runs the whole pipeline with no network access.
SOURCES_ENABLED=mock

# For the `import` source: a JSON or CSV file you export yourself.
# IMPORT_FILE=./data/my-jobs.json

# Search terms, for sources that support querying. Comma-separated.
SEARCH_QUERIES=
# Upper bound on paginated list views.
SCRAPE_MAX_PAGES=2

# For the `companies` source.
SOURCES_CONFIG_PATH=config/sources.yaml

# ------------------------------------------------------------- BROWSER ------
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT_MS=45000
# Politeness delay between navigations, in ms. Do not lower this.
SCRAPE_DELAY_MS=2500
# Leave true. Setting this false disables the robots.txt gate entirely.
RESPECT_ROBOTS_TXT=true

# --------------------------------------------------------------- MISC -------
PROFILE_PATH=config/profile.yaml
OUTPUT_DIR=output
JOB_RUN_CRON="0 8 * * *"

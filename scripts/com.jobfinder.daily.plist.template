<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobfinder.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/scripts/run-daily.sh</string>
    </array>

    <!-- 08:00 every day. Unlike cron, if the Mac is asleep at 08:00 launchd
         runs the job as soon as it wakes rather than skipping the day. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/jobfinder.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/jobfinder.log</string>

    <!-- Do not run on load; wait for the scheduled time. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- A run is a one-shot task. Never restart it on exit. -->
    <key>KeepAlive</key>
    <false/>

    <!-- An 8B model run is CPU-heavy; deprioritise it so it does not fight
         whatever you are doing at 8am. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
